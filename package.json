{
  "name": "@onix/ui-kit",
  "version": "0.1.0",
  "description": "ONIX design tokens, shadcn-based UI primitives and Storybook",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "eslint.config.js",
    "components.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./eslint": "./eslint.config.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:js && npm run build:css && npm run build:types",
    "build:js": "vite build --config vite.lib.config.ts",
    "build:css": "vite build --config vite.styles.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "styled-components": "^6.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.59.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-themes": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "csstype": "3.2.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "shadcn": "^4.22.1",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
